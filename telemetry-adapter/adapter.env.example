# 云服务器独立适配器示例配置。复制到服务器私有环境变量文件后替换占位值，禁止提交真实凭据。
ADAPTER_PORT=8091

ADAPTER_MYSQL_HOST=127.0.0.1
ADAPTER_MYSQL_PORT=3306
ADAPTER_MYSQL_DATABASE=iot_adapter
ADAPTER_MYSQL_USER=adapter
ADAPTER_MYSQL_PASSWORD=change-me

ADAPTER_MQTT_ENABLED=true
ADAPTER_MQTT_BROKER_URL=tcp://127.0.0.1:1883
ADAPTER_MQTT_CLIENT_ID=telemetry-adapter-01
ADAPTER_MQTT_USER=adapter
ADAPTER_MQTT_PASSWORD=change-me
ADAPTER_RAW_TOPIC=device/raw/#
ADAPTER_STANDARD_TOPIC=device/telemetry/up

ADAPTER_PROFILE_REFRESH_MS=60000
ADAPTER_INITIAL_RETRY_MILLIS=5000
ADAPTER_MAX_PAYLOAD_BYTES=65536
