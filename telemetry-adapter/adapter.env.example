# 云服务器独立适配器示例配置。复制到服务器私有环境变量文件后替换占位值，禁止提交真实凭据。
ADAPTER_BIND_ADDRESS=127.0.0.1
ADAPTER_PORT=8091

ADAPTER_MYSQL_HOST=127.0.0.1
ADAPTER_MYSQL_PORT=3306
ADAPTER_MYSQL_DATABASE=iot_adapter
ADAPTER_MYSQL_USER=adapter
ADAPTER_MYSQL_PASSWORD=change-me

ADAPTER_MQTT_ENABLED=true
ADAPTER_MQTT_BROKER_URL=tcp://127.0.0.1:1883
ADAPTER_MQTT_CLIENT_ID=telemetry-adapter-01
ADAPTER_MQTT_USER=adapter
ADAPTER_MQTT_PASSWORD=change-me
ADAPTER_RAW_TOPIC=device/raw/#
ADAPTER_STANDARD_TOPIC=device/telemetry/up

ADAPTER_PROFILE_REFRESH_MS=60000
ADAPTER_PROFILE_MODE=jdbc
ADAPTER_OUTPUT_VERSION=V2
# remote 模式必须使用 HTTPS，base URL 已包含平台 /api 前缀。
ADAPTER_CONFIGURATION_BASE_URL=https://platform.example.com/api
ADAPTER_TARGET_ID=replace-with-target-id
ADAPTER_CONFIGURATION_KEY=replace-with-independent-random-secret
ADAPTER_SNAPSHOT_FILE=data/protocol-snapshot.json
ADAPTER_CONFIGURATION_CONNECT_TIMEOUT_MILLIS=5000
ADAPTER_CONFIGURATION_REQUEST_TIMEOUT_MILLIS=10000
ADAPTER_CONFIGURATION_MAX_RESPONSE_BYTES=2097152
ADAPTER_CONFIGURATION_TRUST_STORE=
ADAPTER_CONFIGURATION_TRUST_STORE_PASSWORD=
ADAPTER_CONFIGURATION_TRUST_STORE_TYPE=PKCS12
ADAPTER_PROFILE_EXPORT_ENABLED=false
ADAPTER_PROFILE_EXPORT_FILE=protocol-migration-export.json
ADAPTER_INITIAL_RETRY_MILLIS=5000
ADAPTER_MAX_PAYLOAD_BYTES=65536
