# Copy this file to server.env and replace the placeholders locally.
# Never commit server.env.

SERVER_HOST=127.0.0.1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me

MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=platform-backend-01
MQTT_USER=admin
MQTT_PASSWORD=change-me

TDENGINE_HOST=127.0.0.1
TDENGINE_PORT=6041
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata

# Generate a random value of at least 32 bytes for each deployment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRE_SECONDS=86400
