# Copy this file to server.env and replace the placeholders locally.
# Never commit server.env.

SERVER_HOST=127.0.0.1

# These ports control both local Compose publishing and Spring Boot connections.
# Keep the defaults unless the host already runs MySQL or Redis.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 服务器部署必须显式标记 production；生产环境开启研发自审会导致应用拒绝启动。
# 单人研发环境可在本地改为 development 并按需启用自审，不能沿用到服务器。
RELATION_GOVERNANCE_ENVIRONMENT=production
RELATION_GOVERNANCE_SELF_APPROVAL_ENABLED=false
RELATION_GOVERNANCE_MAX_CONTEXT_DEPTH=3
RELATION_GOVERNANCE_MAX_PAGE_SIZE=100

# Set false only when this deployment must not connect to the HVAC MQTT broker.
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=platform-backend-01
MQTT_USER=admin
MQTT_PASSWORD=change-me
MQTT_UPSTREAM_TOPIC=device/data/up
MQTT_STANDARD_UPSTREAM_TOPIC=device/telemetry/up
MQTT_INITIAL_RETRY_MILLIS=5000

TDENGINE_HOST=127.0.0.1
TDENGINE_PORT=6041
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata
TDENGINE_HTTP_CONNECT_TIMEOUT_MS=5000
TDENGINE_HTTP_SOCKET_TIMEOUT_MS=30000

# 后台并发与设备数解耦；按任务积压、TDengine 容量和压测结果调整。
BUSINESS_SCHEDULER_POOL_SIZE=4
LATE_REAL_CORRECTION_CONCURRENCY=8
LATE_REAL_CORRECTION_QUEUE_CAPACITY=1000
RECALCULATION_WORKER_CONCURRENCY=2

# Generate a random value of at least 32 bytes for each deployment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRE_SECONDS=86400
