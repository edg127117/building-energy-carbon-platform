{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:platform": "vite --config vite.platform.config.ts --open /platform.html",
    "build": "vue-tsc -b && vite build && vite build --config vite.platform.config.ts",
    "preview": "vite preview",
    "check": "vue-tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --ext .ts,.vue && npm run check:architecture",
    "check:architecture": "node scripts/check-foundation.mjs",
    "lint:fix": "eslint . --ext .ts,.vue --fix"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "axios": "1.18.1",
    "element-plus": "2.14.5",
    "clsx": "^2.1.1",
    "echarts": "5.6.0",
    "lucide-vue-next": "0.511.0",
    "pinia": "2.3.1",
    "tailwind-merge": "^3.3.0",
    "vue": "3.5.39",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vue/test-utils": "2.4.11",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/runtime-dom": "3.5.39",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "5.3.3",
    "unplugin-vue-dev-locator": "^1.0.0",
    "vite": "5.4.21",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vitest": "2.1.9",
    "vue-tsc": "1.8.27"
  }
}
